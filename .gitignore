# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env

# Corpus data (large; reproducible via tools/corpus_prep/)
academic_resolutions/

# Framework outputs (generated Index artifacts & retrieval results)
data/index/
data/results/*
# ...except the residual-relevance review sheet: everything else under
# data/results/ is regenerable by re-running a script, but this one carries
# hand-entered relevance judgements that cannot be reproduced if lost.
!data/results/residual_relevance/
data/models/
data/output/
data/qdrant/
data/logs/

# Word lock files
~$*.doc*

# One-off generated code-explainer doc (regenerated as a new version on request,
# not meant to be tracked/kept in sync with the code)
docs/code-explained.html
docs/code-explained.pdf

# Rendered PDF of the project-journey narrative — generated from the tracked
# docs/project-journey.html (see CLAUDE.md for the render command); the HTML is
# the source of truth, the PDF is a build artifact.
docs/project-journey.pdf
data/rq4/
